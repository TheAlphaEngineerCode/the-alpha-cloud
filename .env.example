# The Alpha Cloud — Local development environment (default values)
# Copy to .env and override as needed. NEVER commit real secrets.

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# API (apps/api)
# ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080

# Cookie / session
SESSION_COOKIE_NAME=cloud_session
SESSION_TTL_SECONDS=2592000
SESSION_SECRET=please-change-me-to-a-32-byte-hex-secret

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Web (apps/web)
# ─────────────────────────────────────────────────────────────
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cloud
POSTGRES_USER=cloud
POSTGRES_PASSWORD=cloud
DATABASE_URL=postgresql://cloud:cloud@127.0.0.1:5432/cloud
# Pool
DB_POOL_MAX=10
DB_POOL_IDLE=30000

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# ─────────────────────────────────────────────────────────────
# Object storage (MinIO / S3 compatible)
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cloud
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─────────────────────────────────────────────────────────────
# Observability (OpenTelemetry)
# ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=cloud
OTEL_RESOURCE_ATTRIBUTES=service.namespace=cloud,deployment.environment=development

# ─────────────────────────────────────────────────────────────
# Security — rate limiting
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60