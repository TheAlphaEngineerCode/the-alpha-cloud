{
  "name": "@cloud/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/drop.ts && tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@cloud/auth": "workspace:*",
    "@cloud/config": "workspace:*",
    "@cloud/database": "workspace:*",
    "@cloud/domain": "workspace:*",
    "@cloud/events": "workspace:*",
    "@cloud/logger": "workspace:*",
    "@cloud/permissions": "workspace:*",
    "@cloud/validation": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.1",
    "pg": "^8.13.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.15.0",
    "pg-mem": "^3.0.14",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
